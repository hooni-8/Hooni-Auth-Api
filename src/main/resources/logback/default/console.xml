<?xml version="1.0" encoding="UTF-8"?>

<included>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS, ${logback.timezone:-Asia/Seoul}} %highlight(%-5level) %cyan([%thread]) %green(%logger{40}) - %msg%n%ex{full}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>${LOG_PATTERN}</Pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 바인딩 값이 반영된 SQL 전용 출력 -->
    <appender name="SQL_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.core.filter.EvaluatorFilter">
            <evaluator class="ch.qos.logback.classic.boolex.OnMarkerEvaluator">
                <marker>LOG4JDBC_SQL</marker>
            </evaluator>
            <OnMatch>ACCEPT</OnMatch>
            <OnMismatch>DENY</OnMismatch>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{HH:mm:ss.SSS, ${logback.timezone:-Asia/Seoul}} %cyan([SQL])&#10;%replace(%msg){'(?s)^[0-9]+[.][ ]*(.*)[ ](\{executed in [0-9]+ ms\})$','$1&#10;$2'}&#10;%nopex</pattern>
        </encoder>
    </appender>

    <!-- SELECT 결과 전용 출력 -->
    <appender name="RESULT_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.core.filter.EvaluatorFilter">
            <evaluator class="ch.qos.logback.classic.boolex.OnMarkerEvaluator">
                <marker>LOG4JDBC_RESULTSETTABLE</marker>
            </evaluator>
            <OnMatch>ACCEPT</OnMatch>
            <OnMismatch>DENY</OnMismatch>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{HH:mm:ss.SSS, ${logback.timezone:-Asia/Seoul}} %green([RESULT])&#10;%msg&#10;%nopex</pattern>
        </encoder>
    </appender>
</included>
